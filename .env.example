# Safar-E-Jahan Travel & Tours - Environment Variables Template
# Copy this file to .env and provide the necessary secrets.

# GEMINI_API_KEY: Required for Gemini AI assistant features.
# Set this to your Google AI Studio API Key.
GEMINI_API_KEY=""

# APP_URL: The public URL where the application is hosted.
# Default for local development is http://localhost:3000
APP_URL="http://localhost:3000"

# RESEND_API_KEY: Optional API key for Resend email delivery.
# When provided, pilgrimage inquiries and confirmation dossiers are sent live to pilgrim emails.
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Use your verified domain sender in production.
# For sandbox testing, Resend's official sender is delivered@resend.dev.
RESEND_FROM_EMAIL="delivered@resend.dev"

# RESEND_TEST_TO_EMAIL: Required only when using the Resend sandbox sender for testing.
# Example: your Gmail address for a sandbox verification send.
RESEND_TEST_TO_EMAIL="muhammadesharib1@gmail.com"

# WHATSAPP_TOKEN: Optional Meta WhatsApp Cloud API token.
# WHATSAPP_TOKEN=""

# WHATSAPP_PHONE_NUMBER_ID: Optional WhatsApp Business Phone Number ID.
# WHATSAPP_PHONE_NUMBER_ID=""
